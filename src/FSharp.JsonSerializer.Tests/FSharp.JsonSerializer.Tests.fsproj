<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="paket.references" />
    <Compile Include="Json.fs" />
    <Compile Include="OptionTests.fs" />
    <Compile Include="TupleTests.fs" />
    <Compile Include="CollectionTests.fs" />
    <Compile Include="TaggedUnionTests.fs" />
    <Compile Include="UntaggedUnionTests.fs" />
    <Compile Include="PropertyTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\FSharp.JsonSerializer\FSharp.JsonSerializer.fsproj" />
  </ItemGroup>
  
  <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>